
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --primary: #2563eb;
    --primary-dark: #1d4ed8;
    --background: #f3f6fb;
    --white: #ffffff;
    --text: #172033;
    --muted: #687386;
    --border: #e1e7f0;
    --green: #15803d;
    --red: #dc2626;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--background);
    color: var(--text);
    line-height: 1.5;
}

button, input, select {
    font: inherit;
}

button {
    cursor: pointer;
}

.header {
    background: var(--white);
    padding: 18px 5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid var(--border);
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
}

.logo {
    font-size: 38px;
}

.brand h1 {
    font-size: 22px;
}

.brand p, .section-heading p, .welcome p {
    color: var(--muted);
    font-size: 14px;
}

.status {
    color: var(--green);
    background: #dcfce7;
    padding: 7px 12px;
    border-radius: 20px;
    font-size: 12px;
    white-space: nowrap;
}

.container {
    width: 92%;
    max-width: 1400px;
    margin: 28px auto;
}

.welcome {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 24px;
}

.welcome h2 {
    font-size: 28px;
    margin-bottom: 5px;
}

.primary-btn, .secondary-btn, .action-btn {
    border: none;
    border-radius: 8px;
    padding: 11px 16px;
    font-weight: 600;
    transition: 0.2s;
}

.primary-btn {
    background: var(--primary);
    color: white;
}

.primary-btn:hover {
    background: var(--primary-dark);
}

.secondary-btn {
    background: #e9eef7;
    color: var(--text);
}

.stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    margin-bottom: 25px;
}

.stat-card, .panel {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 22px;
    box-shadow: 0 3px 12px rgba(15, 23, 42, 0.035);
}

.stat-icon {
    font-size: 25px;
}

.stat-card p {
    color: var(--muted);
    font-size: 14px;
    margin-top: 10px;
}

.stat-card h2 {
    font-size: 30px;
    margin-top: 5px;
    color: var(--primary);
}

.panel {
    margin-bottom: 25px;
}

.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.section-heading h2 {
    font-size: 21px;
    margin-bottom: 3px;
}

.filters {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 12px;
    margin-bottom: 20px;
}

input, select {
    width: 100%;
    padding: 11px 12px;
    border: 1px solid #d6deea;
    border-radius: 8px;
    background: white;
    color: var(--text);
    outline: none;
    min-width: 0;
}

input:focus, select:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
}

.table-wrap {
    width: 100%;
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 760px;
}

th, td {
    text-align: left;
    padding: 14px 12px;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
}

th {
    background: #f7f9fc;
    color: #566176;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
}

td strong {
    display: block;
    font-size: 14px;
    margin-bottom: 3px;
}

.subtext {
    color: var(--muted);
    font-size: 12px;
}

.pill {
    display: inline-block;
    padding: 5px 9px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
}

.pill.available, .pill.returned {
    background: #dcfce7;
    color: #166534;
}

.pill.unavailable, .pill.issued {
    background: #fee2e2;
    color: #991b1b;
}

.actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.action-btn {
    padding: 6px 9px;
    font-size: 12px;
}

.edit-btn {
    background: #dbeafe;
    color: #1d4ed8;
}

.delete-btn {
    background: #fee2e2;
    color: #b91c1c;
}

.return-btn {
    background: #dcfce7;
    color: #166534;
}

.empty-message {
    text-align: center;
    padding: 25px;
    color: var(--muted);
}

.issue-form {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1.5fr 0.7fr auto;
    gap: 12px;
    align-items: end;
    margin-bottom: 24px;
}

.field {
    margin-bottom: 16px;
}

.field label {
    display: block;
    font-weight: 600;
    font-size: 13px;
    margin-bottom: 7px;
}

.issue-form .field {
    margin-bottom: 0;
}

.issue-form .primary-btn {
    white-space: nowrap;
}

.modal {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.6);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 18px;
    z-index: 10;
    overflow-y: auto;
}

.modal[hidden] {
    display: none;
}

.modal-content {
    width: 100%;
    max-width: 480px;
    max-height: 95vh;
    overflow-y: auto;
    background: white;
    border-radius: 16px;
    padding: 25px;
}

.modal-heading {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 22px;
}

.modal-heading h2 {
    font-size: 22px;
}

.modal-heading p {
    color: var(--muted);
    font-size: 13px;
}

.close-btn {
    border: none;
    background: transparent;
    font-size: 30px;
    color: var(--muted);
    align-self: flex-start;
}

.modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 20px;
}

.toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background: #172033;
    color: white;
    padding: 13px 18px;
    border-radius: 9px;
    box-shadow: 0 5px 20px #0002;
    z-index: 20;
    opacity: 0;
    pointer-events: none;
    transform: translateY(10px);
    transition: 0.25s;
}

.toast.show {
    opacity: 1;
    transform: translateY(0);
}

footer {
    text-align: center;
    color: var(--muted);
    padding: 20px;
    font-size: 13px;
}

@media (max-width: 1000px) {
    .stats {
        grid-template-columns: repeat(2, 1fr);
    }

    .issue-form {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .issue-form button {
        align-self: end;
    }
}

@media (max-width: 600px) {
    .header {
        padding: 15px 4%;
    }

    .brand h1 {
        font-size: 17px;
    }

    .brand p {
        font-size: 11px;
    }

    .logo {
        font-size: 30px;
    }

    .status {
        font-size: 10px;
        padding: 5px 7px;
    }

    .container {
        width: 94%;
        margin-top: 20px;
    }

    .welcome {
        align-items: flex-start;
        flex-direction: column;
    }

    .welcome h2 {
        font-size: 23px;
    }

    .stats {
        gap: 10px;
    }

    .stat-card {
        padding: 15px;
    }

    .stat-card h2 {
        font-size: 25px;
    }

    .stat-card p {
        font-size: 12px;
    }

    .panel {
        padding: 15px;
    }

    .filters {
        grid-template-columns: 1fr;
    }

    .issue-form {
        grid-template-columns: 1fr;
    }

    .issue-form .field {
        margin-bottom: 0;
    }

    .toast {
        left: 15px;
        right: 15px;
        bottom: 15px;
        text-align: center;
    }
}
